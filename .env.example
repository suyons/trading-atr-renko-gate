# Exchange selection
EXCHANGE=gate                # gate | binance
TRADING_MODE=TEST            # TEST (testnet/demo) | LIVE (real money)

# Gate.io API host (used when EXCHANGE=gate)
GATE_URL_HOST_LIVE=https://api.gateio.ws/api/v4
GATE_URL_HOST_TEST=https://api-testnet.gateapi.io/api/v4

# API keys and secrets, per exchange and mode.
# Prefer the EXCHANGE-prefixed names; the unprefixed fallback also works.
GATE_API_KEY_LIVE=your_api_key_here
GATE_API_SECRET_LIVE=your_api_secret_here
GATE_API_KEY_TEST=your_api_key_here
GATE_API_SECRET_TEST=your_api_secret_here

BINANCE_API_KEY_LIVE=your_api_key_here
BINANCE_API_SECRET_LIVE=your_api_secret_here
BINANCE_API_KEY_TEST=your_api_key_here
BINANCE_API_SECRET_TEST=your_api_secret_here

# Discord webhook URL for notifications
DISCORD_WEBHOOK_URL_LIVE=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
DISCORD_WEBHOOK_URL_TEST=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Chart parameters
SYMBOL_LIST=BTC_USDT,ETH_USDT
OHLCV_TIMEFRAME=1m
ATR_PERIOD=14
OHLCV_COUNT=2000

# Order parameters
LEVERAGE=2

# Optional LLM reversal filter. Command that reads a prompt arg and replies
# ENTER/SKIP. Opt-in: set a command to enable; unset/empty disables it.
FILTER_AGENT_CMD=claude -p
